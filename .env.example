KOK_APP_NAME=KOK.AI API
KOK_ENV=dev
KOK_DEBUG=false
KOK_API_PREFIX=/api/v1

KOK_DATABASE_URL=postgresql+psycopg://kok:kok@postgres:5432/kok
KOK_REDIS_URL=redis://redis:6379/0

KOK_JWT_ACCESS_SECRET=change_me_access_secret_123
KOK_JWT_REFRESH_SECRET=change_me_refresh_secret_456
KOK_JWT_ACCESS_EXPIRE_MINUTES=15
KOK_JWT_REFRESH_EXPIRE_DAYS=30

KOK_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public origin used in mobile-facing media URLs. Production must be HTTPS.
KOK_PUBLIC_API_BASE_URL=http://localhost:8000
KOK_MINIMUM_SUPPORTED_MOBILE_VERSION=1.0.0
KOK_LATEST_MOBILE_VERSION=1.0.0
KOK_IOS_STORE_URL=
KOK_ANDROID_STORE_URL=
KOK_MAINTENANCE_MODE=false
KOK_MAINTENANCE_MESSAGE=

# Server-side plant analysis provider. Set exactly one provider active.
KOK_PLANT_ANALYSIS_PROVIDER=openai
KOK_OPENAI_API_KEY=
KOK_OPENAI_MODEL=gpt-5.6-luna
KOK_OPENAI_TIMEOUT_SECONDS=30
KOK_OPENAI_MAX_OUTPUT_TOKENS=1800

# Kindwise Plant.id v3 remains available as the fallback provider.
KOK_KINDWISE_API_KEY=
KOK_KINDWISE_BASE_URL=https://plant.id/api/v3
KOK_KINDWISE_LANGUAGE=en
KOK_KINDWISE_FALLBACK_LANGUAGE=en
KOK_KINDWISE_HEALTH_MODE=off
KOK_KINDWISE_SUGGESTION_FILTER=tree
KOK_KINDWISE_CLASSIFICATION_LEVEL=species
KOK_KINDWISE_TIMEOUT_SECONDS=12
KOK_KINDWISE_MAX_CONCURRENCY=4
KOK_IDEMPOTENCY_TTL_HOURS=24
KOK_ABANDONED_UPLOAD_TTL_HOURS=24
KOK_ANALYSIS_TTL_HOURS=24

KOK_AI_MAX_IMAGES=5
KOK_AI_MAX_IMAGE_BYTES=15728640
KOK_AI_MAX_REQUEST_BYTES=40000000
KOK_REQUEST_MULTIPART_OVERHEAD_BYTES=2000000
KOK_AI_MAX_PIXELS=40000000
KOK_AI_LOW_CONFIDENCE_THRESHOLD=0.55
KOK_AI_MAX_CONCURRENT_ANALYSES=4
KOK_ANALYSIS_RATE_LIMIT_PER_MINUTE=10

KOK_S3_ENDPOINT_URL=http://minio:9000
KOK_S3_ACCESS_KEY=minioadmin
KOK_S3_SECRET_KEY=minioadmin
KOK_S3_BUCKET=kok-assets
KOK_S3_REGION=us-east-1
KOK_S3_PUBLIC_BASE_URL=http://localhost:9000
KOK_S3_USE_SSL=false
KOK_S3_INITIALIZE_BUCKET_ON_STARTUP=true

KOK_MAX_IMAGE_SIZE_BYTES=15728640
KOK_ALLOWED_IMAGE_TYPES=image/jpeg,image/png

KOK_RATE_LIMIT_AUTH_PER_MINUTE=20
KOK_RATE_LIMIT_WRITE_PER_MINUTE=60

KOK_CELERY_BROKER_URL=redis://redis:6379/1
KOK_CELERY_RESULT_BACKEND=redis://redis:6379/2

KOK_TREE_DETECTOR_ENABLED=false
KOK_TREE_DETECTOR_MODEL_PATH=tree_detector/treedetect.pt
KOK_TREE_DETECTOR_CONFIDENCE=0.25
KOK_TREE_DETECTOR_MODEL_VERSION=treedetect.pt
